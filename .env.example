# ------------------------------------------------------------------
# MetraScan backend configuration (copy to apps/api/.env)
# ------------------------------------------------------------------

# Server
NODE_ENV=development
API_PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
# Example: postgresql://YOUR_USER@localhost:5432/metrascan
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/metrascan

# Auth — generate a random secret: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# AI service (used from Phase 2 onward)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000
# Shared secret for the Node API ↔ AI service boundary. Required in production.
# Generate with: openssl rand -hex 24, and set the SAME value in apps/ai/.env.
# In dev without this value, both services refuse to talk to each other.
AI_SERVICE_TOKEN=

# Local file storage root (used from Phase 2 onward)
STORAGE_PATH=./storage

# Optional: seed an initial ADMIN account via `pnpm db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
