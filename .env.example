# ==============================================================================
# MetraScan Production & Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# Copy this file to:
#   - `.env` for Docker Compose production deployments
#   - `apps/api/.env` for backend local development or container deployment
#   - `apps/ai/.env` for AI service local development or container deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# For Docker Compose deployments:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=metrascan

# For Backend API (Prisma connection string):
# - Docker Compose internal networking:
#   DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/metrascan?schema=public
# - Managed Cloud Database (Supabase, Neon, AWS RDS):
#   DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DATABASE_URL=postgresql://postgres:generate_a_strong_database_password_here@localhost:5432/metrascan?schema=public

# ------------------------------------------------------------------------------
# 2. Authentication & Security (API)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (MUST be at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# 3. Inter-Service Communication (Node API ↔ Python AI Service)
# ------------------------------------------------------------------------------
# Shared secret for internal service boundary authentication.
# In production, BOTH the API and AI services MUST share the EXACT SAME token.
# Generate with: openssl rand -hex 24
AI_SERVICE_TOKEN=replace_with_a_secure_random_shared_service_token_min_16_chars

# URL where the Node API reaches the AI service:
# - Docker Compose: http://ai:8000
# - Local development: http://localhost:8000
# - Cloud PaaS: https://your-ai-service.onrender.com
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# 4. Server Networking & Ports
# ------------------------------------------------------------------------------
NODE_ENV=production

# Backend listening port (supports PaaS PORT or API_PORT; defaults to 4000)
PORT=4000
API_PORT=4000

# External port mappings for Docker Compose
API_EXTERNAL_PORT=4000
WEB_EXTERNAL_PORT=80

# Allowed CORS Origin for Express API:
# Must match the URL of the frontend application.
# Examples: http://localhost, https://metrascan.gov.in, https://metrascan.vercel.app
CLIENT_URL=http://localhost

# ------------------------------------------------------------------------------
# 5. Persistent File Storage
# ------------------------------------------------------------------------------
# Directory where package images, crops, and generated PDF reports are persisted.
# - Production container / Docker Compose: /data/storage (mounted to volume)
# - Local development: ./storage
STORAGE_PATH=./storage

# ------------------------------------------------------------------------------
# 6. AI / OCR Engine Options (Python Service)
# ------------------------------------------------------------------------------
# Primary OCR engine: "paddle" (default & recommended) or "tesseract"
OCR_PROVIDER=paddle
OCR_LANG=en

# Image processing thresholds (optional overrides)
# MAX_IMAGE_BYTES=10485760
# OCR_TIMEOUT_SECONDS=120
# BLUR_PASS=100.0
# BLUR_FAIL=45.0
# BRIGHTNESS_MIN=50
# BRIGHTNESS_MAX=235
# CONTRAST_MIN=25

# ------------------------------------------------------------------------------
# 7. First-Time Admin Account Provisioning (One-time CLI use)
# ------------------------------------------------------------------------------
# In production, self-registration is disabled. Seed the initial ADMIN user via:
# SEED_ADMIN_EMAIL=admin@example.com SEED_ADMIN_PASSWORD=StrongPassword123 pnpm db:seed
# Do NOT keep admin passwords in persistent runtime environment files.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
